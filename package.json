{
  "name": "temporal-poc-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:all": "nx run-many -t dev,serve",
    "build": "bun run --filter web build",
    "preview": "bun run --filter web preview",
    "deploy": "bun run --filter web deploy",
    "generate-routes": "bun run --filter web generate-routes",
    "dev:temporal-api": "nx serve temporal-api",
    "build:temporal-api": "nx build temporal-api",
    "dev:temporal-worker": "nx serve temporal-worker",
    "build:temporal-worker": "nx build temporal-worker",
    "test:temporal-worker": "nx test temporal-worker",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "devDependencies": {
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/node": "23.2.1",
    "@swc/helpers": "~0.5.18",
    "@tanstack/eslint-config": "latest",
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.20.0",
    "nx": "23.2.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/autoload": "~6.0.3",
    "@fastify/sensible": "~6.0.2",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "fastify": "~5.2.1",
    "fastify-plugin": "~5.0.1",
    "tslib": "^2.3.0",
    "zod": "^4.3.6"
  }
}
