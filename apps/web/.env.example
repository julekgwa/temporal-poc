# Twenty CRM (server-only; never prefix these with VITE_)
TWENTY_API_URL=https://api.twenty.com
TWENTY_API_KEY=
# ISO 3166-1 alpha-2 country code used for phone fields
TWENTY_DEFAULT_PHONE_COUNTRY_CODE=ZA
TWENTY_DEFAULT_PHONE_CALLING_CODE=+27

# Base URL of the temporal-api service, called to start the onboarding workflow
TEMPORAL_API_URL=http://localhost:3000
